server {
    server_name __FQDN__;
    client_max_body_size 50M;

    # Authentication endpoints — per-IP rate limits (zones defined in
    # conf.d/docketworks-ratelimit.conf, installed by server-setup.sh).
    # Over-limit requests get 429, which fail2ban deliberately ignores;
    # only genuine 401s from the app count toward a ban. Exact-match
    # locations so nothing else inherits the limits.
    location = /api/accounts/token/ {
        limit_req zone=dw_login burst=5 nodelay;
        proxy_pass http://unix:/opt/docketworks/instances/__INSTANCE__/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/accounts/token/refresh/ {
        limit_req zone=dw_refresh burst=20 nodelay;
        proxy_pass http://unix:/opt/docketworks/instances/__INSTANCE__/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The data-versions stream, and only it: an SSE response holds its
    # connection open by design and produces bytes that must not sit in a
    # proxy buffer, so it needs HTTP/1.1 with no Connection header, hour-long
    # timeouts and no buffering. Every other API request must NOT inherit that
    # allowance — under it a stalled ordinary request occupies a worker
    # connection for an hour instead of failing at the default 60s.
    location = /api/data-versions/stream/ {
        proxy_pass http://unix:/opt/docketworks/instances/__INSTANCE__/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Django backend — API only (no Django admin is registered)
    location /api/ {
        proxy_pass http://unix:/opt/docketworks/instances/__INSTANCE__/gunicorn.sock;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # MEDIA_ROOT only: staff icons and company logos, whose /media/ URLs the
    # API returns for the SPA to render (config/urls.py serves the DEBUG
    # equivalent). Job files, dropbox documents and phone recordings live
    # OUTSIDE mediafiles/ and are reachable only through authenticated API
    # endpoints — never alias those roots here.
    location /media/ {
        alias /opt/docketworks/instances/__INSTANCE__/mediafiles/;
    }

    # SPA entry point — never cache, otherwise a hard reload fetches a stale
    # HTML that still references the previous build's hashed /assets/*.
    # index.html is the only pointer to a specific build.
    location = /index.html {
        root /opt/docketworks/instances/__INSTANCE__/app/frontend/dist;
        add_header Cache-Control "no-store" always;
    }

    # React frontend — everything else (shared release build)
    location / {
        root /opt/docketworks/instances/__INSTANCE__/app/frontend/dist;
        try_files $uri $uri/ /index.html;
    }

    error_log /var/log/nginx/docketworks___INSTANCE___error.log;
    access_log /var/log/nginx/docketworks___INSTANCE___access.log docketworks_timed_combined;

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/__CERT_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_DOMAIN__/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name __FQDN__;
    return 301 https://$host$request_uri;
}
