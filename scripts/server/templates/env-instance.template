# WARNING: Keep this file in sync with .env.example. Any setting added here
# should also be added to .env.example so local/dev setup and newly-created
# server instances use the same required settings contract.
# Every variable below is read by config/settings.py (fail-fast at boot) or
# by an ops script — this file deliberately carries nothing the code does
# not consume.

# Django core
DEBUG=False
SECRET_KEY=__SECRET_KEY__
# JWT signing key: deliberately distinct from SECRET_KEY (settings.py
# refuses to boot if they match) so a Django key rotation does not force a
# fleet-wide re-login and vice versa.
JWT_SIGNING_KEY=__JWT_SIGNING_KEY__

# Instance slug — matches systemd unit naming (gunicorn-<INSTANCE>.service,
# celery-beat-<INSTANCE>.service, celery-worker-<INSTANCE>.service). Read by
# apps/xero/active_app.py to dispatch sibling-worker restarts during a Xero
# credential swap. Distinct from DB_NAME (which uses underscores) because
# systemd unit names use hyphens.
INSTANCE=__INSTANCE__

# Database (PostgreSQL — local Unix socket, per-instance role)
DB_NAME=__DB_NAME__
DB_USER=__DB_USER__
DB_PASSWORD=__DB_PASSWORD__
DB_HOST=/var/run/postgresql
DB_PORT=5432
# Scratch database for the scrub-pipeline commands (backport_data_backup on
# prod). Provisioned by instance.sh alongside DB_NAME; must end in _scrub.
SCRUB_DB_NAME=__SCRUB_DB_NAME__
# Per-tenant pytest role (read by config/settings_test.py, never by the app).
# Provisioned by instance.sh with CREATEDB but no database of its own: the
# test runner creates and drops the throwaway dw_<client>_<env>_test database
# (one clone per xdist worker), so test runs never touch DB_NAME.
TEST_DB_USER=__TEST_DB_USER__
TEST_DB_PASSWORD=__TEST_DB_PASSWORD__

# Google service-account key. The app reads it (apps/core/gauth.py): the
# password-reset email sends through Gmail and the health-and-safety import
# writes to Drive, as well as the rclone backup upload and the scripts/gdocs/
# authoring toolchain.
#
# Opus: the instance's own copy, NOT the path the operator wrote in the
# credentials file — that one is a download on the admin's machine which
# client_onboarding.md tells them to delete once instance.sh has copied it.
# Not blank either: gauth fails loud on an unset key, so a blank value here
# takes out Gmail and the Drive import on an instance that holds the key.
#
# GCP_DELEGATED_SUBJECT overrides the Workspace user domain-wide delegation
# impersonates. Left empty on instances: gauth falls back to
# CompanyDefaults.company_email, which on a real instance IS that user.
GCP_CREDENTIALS=__GCP_CREDENTIALS__
GCP_DELEGATED_SUBJECT=

# Redis. The database number is allocated per instance by instance.sh —
# the broker (this URL) must never be shared between instances on one
# host, or one instance's celery worker consumes another's tasks.
# Database 2 is reserved: settings.py derives the cross-process "shared"
# cache as database 2 of the same server (KEY_PREFIX isolates instances).
REDIS_URL=redis://127.0.0.1:6379/__REDIS_DB__

# Public identity
APP_DOMAIN=__FQDN__
FRONT_END_URL=https://__FQDN__

# Suppress all Xero writes for this process (production hotfix valve —
# reads and token refresh stay live). Never true on a live instance.
XERO_READONLY=False

# Instance-local file roots. mediafiles is the one nginx serves at
# /media/ (staff icons, company logos) and MUST live outside the
# immutable release directory or uploads land somewhere root-owned that
# the next deploy discards. The other two are reachable only through
# authenticated endpoints.
MEDIA_ROOT=/opt/docketworks/instances/__INSTANCE__/mediafiles
# Fable: must be the directory that DIRECTLY contains the Job-<number>
# folders. On a client whose workflow folder is Dropbox-synced, point this
# at the synced workflow subfolder (e.g. .../Dropbox/MSM Workflow), never
# the Dropbox root: one level too high 404s every attachment while new job
# folders spawn at the Dropbox top level, with every daemon healthy
# (2026-08-31 production incident). An operator edit here survives
# reconfigure — render_instance_env reads the value back like the
# generated credentials. Keep the quotes: dw-run.sh SOURCES this file, and
# an unquoted path containing a space aborts the source mid-file.
DROPBOX_WORKFLOW_FOLDER="__DROPBOX_WORKFLOW_FOLDER__"
PHONE_RECORDING_STORAGE_ROOT=/opt/docketworks/instances/__INSTANCE__/phone-recordings
SESSION_REPLAY_STORAGE_ROOT=/opt/docketworks/instances/__INSTANCE__/session-replays
