[Unit]
Description=Gunicorn instance for docketworks __INSTANCE__
After=network.target redis-server.service postgresql.service
Requires=redis-server.service

[Service]
# Restart on any exit: systemd's default is Restart=no, which would leave
# the instance serving 502s after an OOM kill until an operator noticed.
Restart=always
RestartSec=5
User=__INSTANCE_USER__
Group=www-data
WorkingDirectory=/opt/docketworks/instances/__INSTANCE__/app
# uvicorn_worker, not gthread: Django's ASGI handler is what lets an SSE
# stream await on the event loop instead of pinning a worker for its
# whole life, so each worker serves many concurrent streams. It wraps
# each request in its own ThreadSensitiveContext, so sync views are not
# serialised per worker either and this count does not cap them; the
# caps are database connections (CONN_MAX_AGE=0) and memory. Resize
# against observed load, not against this number (ADR 0047).
ExecStart=/opt/docketworks/instances/__INSTANCE__/app/.venv/bin/gunicorn \
          -k uvicorn_worker.UvicornWorker \
          --workers 4 \
          --timeout 180 \
          --bind unix:/opt/docketworks/instances/__INSTANCE__/gunicorn.sock \
          config.asgi:application
EnvironmentFile=/opt/docketworks/instances/__INSTANCE__/.env
Environment=PYTHONDONTWRITEBYTECODE=1

[Install]
WantedBy=multi-user.target
