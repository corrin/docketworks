# Instance configuration — fill this out before running 'instance.sh create'
#
# Everything here is loaded into the instance's DATABASE as fixture rows
# (Xero app, AI providers, phone provider) or consumed by the backup
# machinery (Drive service account). None of it lands in the app's .env —
# v2 reads integration credentials from the database, not the environment.
# Existing instances restored from a v1 database already carry these rows;
# the loaders skip anything already configured.

# ─── XERO INTEGRATION ───────────────────────────────────────────────────────────
#   The business already has a Xero organisation. We create a Xero *app*
#   (an API connection to the existing org), not a new Xero account.
#
#   1. Go to https://developer.xero.com/app/manage → "New App"
#      - App name: "Docketworks <instance>" (e.g. "Docketworks MSM")
#      - Company or application URL: https://www.docketworks.site/
#      - Redirect URI: https://__INSTANCE__.docketworks.site/api/xero/oauth/callback/
#   2. On the app's Configuration page → copy the Client ID and Client Secret
#      into XERO_CLIENT_ID / XERO_CLIENT_SECRET below.
#   3. Go to the Webhooks section → "Add webhook"
#      - Delivery URL: https://__INSTANCE__.docketworks.site/api/xero/webhook/
#      - Copy the "Webhook signing key" into XERO_WEBHOOK_KEY below.

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=
XERO_REDIRECT_URI=https://__INSTANCE__.docketworks.site/api/xero/oauth/callback/

# ─── AI PROVIDERS ───────────────────────────────────────────────────────────────
#   API keys for the LLM gateway (loaded as ai.AIProvider rows; every AI
#   call goes through apps/ai's LiteLLM client).

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# ─── BACKUP UPLOADS (Google Drive via rclone) ──────────────────────────────────
#   Nightly database and file backups are uploaded to Google Drive with a
#   GCP service account. Create or reuse one:
#     GCP Console → IAM & Admin → Service Accounts → Create Service Account
#     (no IAM roles needed) → Keys tab → "Add Key" → JSON → download.
#   Share the backup Drive folder with the service account's email address.
#
#   GCP_CREDENTIALS = path to the downloaded JSON key file. instance.sh
#   copies it to <instance>/gcp-credentials.json; the original can then be
#   deleted.
#   BACKUP_GDRIVE_ROOT_FOLDER_ID: Drive folder ID to upload into.
#   BACKUP_GDRIVE_TEAM_DRIVE_ID: only if the folder lives on a shared drive.

GCP_CREDENTIALS=
BACKUP_GDRIVE_ROOT_FOLDER_ID=
BACKUP_GDRIVE_TEAM_DRIVE_ID=

# ─── PHONE PROVIDER (optional) ──────────────────────────────────────────────────
#   CRM phone-call ingestion. Leave the enable flags false unless this
#   client uses the phone integration; when either is true, the four
#   credentials below become required.

PHONE_PROVIDER_DOWNLOADS_ENABLED=false
PHONE_PROVIDER_RECORDING_DELETION_ENABLED=false
PHONE_PROVIDER_BASE_URL=
PHONE_PROVIDER_USERNAME=
PHONE_PROVIDER_PASSWORD=
PHONE_PROVIDER_ACCOUNT_CODE=
