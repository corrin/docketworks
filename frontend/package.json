{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "openapi-ts",
    "check:boundary": "node scripts/check-api-boundary.mjs",
    "type-check": "tsc -b",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview:e2e": "vite build && vite preview",
    "test:e2e": "playwright test --max-failures=1",
    "test:e2e:payroll": "E2E_XERO_PAYROLL=1 playwright test --max-failures=1 --grep @xero-payroll-write",
    "test:e2e:reset": "tsx tests/scripts/e2e-reset.ts",
    "manual:screenshots": "tsx scripts/capture-screenshots.ts",
    "format": "prettier --write src tests scripts *.ts",
    "format:check": "prettier --check src tests scripts *.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fullcalendar/react": "7.1.3",
    "@openai/chatkit-react": "1.6.1",
    "@rrweb/record": "2.1.7",
    "@tanstack/react-query": "5.104.4",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-table": "9.3.1",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.59.0",
    "quill": "2.0.3",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rrweb-player": "2.1.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.6",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.1",
    "@rrweb/types": "2.1.7",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.47",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/adm-zip": "0.6.0",
    "@types/debug": "4.1.13",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "adm-zip": "0.6.1",
    "axe-core": "4.14.0",
    "debug": "4.4.3",
    "dotenv": "18.0.8",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "//": [
    "overrides.js-yaml: @hey-api/json-schema-ref-parser pins js-yaml exactly at 4.2.0, which is vulnerable (GHSA-52cp-r559-cp3m, GHSA-5p4m-2wfm-xmqj, GHSA-2883-xcg3-v3hh); the override forces 4.3.2, the newest patched 4.x that still satisfies @apidevtools/json-schema-ref-parser's ^4.2.0. A transitive package, not a deferral (ADR 0033)."
  ],
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
