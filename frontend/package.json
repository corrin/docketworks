{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "openapi-ts",
    "check:boundary": "node scripts/check-api-boundary.mjs",
    "type-check": "tsc -b",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview:e2e": "vite build && vite preview",
    "test:e2e": "playwright test --max-failures=1",
    "test:e2e:payroll": "E2E_XERO_PAYROLL=1 playwright test --max-failures=1 --grep @xero-payroll-write",
    "test:e2e:reset": "tsx tests/scripts/e2e-reset.ts",
    "manual:screenshots": "tsx scripts/capture-screenshots.ts",
    "format": "prettier --write src tests scripts *.ts",
    "format:check": "prettier --check src tests scripts *.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fullcalendar/core": "6.1.21",
    "@fullcalendar/interaction": "6.1.21",
    "@fullcalendar/react": "6.1.21",
    "@fullcalendar/timegrid": "6.1.21",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.31",
    "@tanstack/react-table": "9.1.2",
    "axios": "1.19.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.30.0",
    "quill": "2.0.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.26",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/adm-zip": "0.5.8",
    "@types/debug": "4.1.13",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.11",
    "adm-zip": "0.6.0",
    "axe-core": "4.13.0",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "js-yaml": "4.3.1"
  }
}
