{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "gen:api": "openapi-ts",
    "check:boundary": "node scripts/check-api-boundary.mjs",
    "type-check": "tsc -b",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview:e2e": "vite build && vite preview",
    "test:e2e": "playwright test --max-failures=1",
    "test:e2e:payroll": "E2E_XERO_PAYROLL=1 playwright test --max-failures=1 --grep @xero-payroll-write",
    "test:e2e:reset": "tsx tests/scripts/e2e-reset.ts",
    "manual:screenshots": "tsx scripts/capture-screenshots.ts",
    "format": "prettier --write src tests scripts *.ts",
    "format:check": "prettier --check src tests scripts *.ts"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "3.1.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.2.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fullcalendar/react": "7.1.0",
    "@openai/chatkit-react": "1.6.1",
    "@rrweb/record": "^2.1.4",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.36",
    "@tanstack/react-table": "9.2.4",
    "axios": "1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.46.0",
    "quill": "2.0.3",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rrweb-player": "^2.1.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "temporal-polyfill": "1.0.5",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@rrweb/types": "2.1.4",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.38",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/adm-zip": "0.5.8",
    "@types/debug": "4.1.13",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "adm-zip": "0.6.1",
    "axe-core": "4.13.0",
    "debug": "4.4.3",
    "dotenv": "17.4.2",
    "jsdom": "30.0.1",
    "msw": "2.15.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "svelte": "^5.57.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "//": "ADR 0033 blocking reason — js-yaml stays at 4.3.2 (below latest 5.x): @hey-api/json-schema-ref-parser pins exactly 4.2.0 and @apidevtools/json-schema-ref-parser requires ^4.2.0, so upstream metadata caps the chain below 5. The override forces 4.3.2 because 4.2.0 is vulnerable (GHSA-52cp-r559-cp3m, GHSA-5p4m-2wfm-xmqj, GHSA-2883-xcg3-v3hh) and 4.3.2 is the newest patched 4.x.",
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
