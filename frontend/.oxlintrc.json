{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn", "import"],
  "jsPlugins": [
    {
      "name": "i18next",
      "specifier": "eslint-plugin-i18next"
    }
  ],
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/react-in-jsx-scope": "off",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "@fontsource*/**", "@fontsource*", "@/lib/i18n"]
      }
    ],
    "eqeqeq": "error",
    "no-var": "error",
    "prefer-const": "error"
  },
  "ignorePatterns": ["src/api/generated/**", "src/routeTree.gen.ts", "dist/**"],
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "react/rules-of-hooks": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      "files": ["scripts/**", "tests/scripts/**", "tests/e2e/**"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "src/features/shell/**",
        "src/features/auth/**",
        "src/routes/**",
        "src/features/shared/**",
        "src/components/**",
        "src/lib/**",
        "src/features/job/**",
        "src/features/kanban/**"
      ],
      "rules": {
        "i18next/no-literal-string": [
          "error",
          {
            "mode": "jsx-only",
            "jsx-attributes": {
              "include": [
                "title",
                "aria-label",
                "placeholder",
                "alt",
                "label",
                "description",
                "emptyText",
                "errorLabel",
                "confirmText"
              ]
            },
            "words": {
              "exclude": ["^[^A-Za-z]*$", "^(true|false)$"]
            }
          }
        ]
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test/**"],
      "rules": {
        "i18next/no-literal-string": "off"
      }
    }
  ]
}
