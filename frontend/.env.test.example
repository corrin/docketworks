# Copy to frontend/.env.test (gitignored). Playwright loads .env, then overlays
# this file (playwright.config.ts). Used by tests/e2e/fixtures/auth.ts.
E2E_TEST_USERNAME=
E2E_TEST_PASSWORD=
# The workshop (shop-floor, non-office) login the phone specs sign in as.
E2E_WORKSHOP_USERNAME=
E2E_WORKSHOP_PASSWORD=
# An office login that is not a superuser: the approve-time spec signs in as
# it. Any address; it receives no mail.
E2E_OFFICE_STAFF_USERNAME=
E2E_OFFICE_STAFF_PASSWORD=
# The password-reset spec sends a real email to the workshop login's address
# and reads it back, so that address must be a plus-address of a real mailbox
# in the instance's Google Workspace, and the tag must name the environment:
# name+e2e-dev@your-domain on a workstation, name+e2e-uat@ on UAT,
# name+e2e-prod@ for a production verification run. A reset email in the
# mailbox then says which environment sent it, and since the reader matches
# the exact address no environment can pick up another's link.
# This is the Workspace user that mailbox belongs to (name@your-domain).
E2E_RESET_MAILBOX_OWNER=

