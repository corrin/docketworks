{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend Dev Server",
      "type": "process",
      "command": "${env:HOME}/.nvm/nvm-exec",
      "args": ["npm", "run", "dev"],
      "hide": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Frontend Preview (build)",
      "type": "process",
      "command": "${env:HOME}/.nvm/nvm-exec",
      "args": ["npm", "run", "preview:e2e"],
      "hide": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-preview",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ngrok Tunnels",
      "type": "shell",
      "command": "ngrok start dev --config ${workspaceFolder}/ngrok.yml",
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "ngrok",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "started tunnel"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Django (runserver)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": ["${workspaceFolder}/manage.py", "runserver", "--noreload"],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "django",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Starting development server"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Celery Worker",
      "type": "shell",
      "command": "poetry run celery -A docketworks worker --concurrency=4 --loglevel=info",
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "celery",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "celery@.* ready"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Celery Beat",
      "type": "shell",
      "command": "poetry run celery -A docketworks beat --loglevel=info --scheduler django_celery_beat.schedulers:DatabaseScheduler",
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "celery-beat",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "beat: Starting\\.\\.\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Dev Environment",
      "dependsOn": [
        "Frontend Dev Server",
        "Ngrok Tunnels",
        "Celery Worker",
        "Celery Beat"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Start E2E Environment",
      "detail": "Serves the production BUILD on :5173 + plain Django on :8000 (no debugger) for E2E runs, fast over ngrok/LAN. Stop 'Start Dev Environment' AND the Run>Debug 'Django' session first — both bind :5173/:8000.",
      "dependsOn": [
        "Frontend Preview (build)",
        "Django (runserver)",
        "Ngrok Tunnels",
        "Celery Worker",
        "Celery Beat"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Rebuild Schema",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/update_schema.sh",
      "hide": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
