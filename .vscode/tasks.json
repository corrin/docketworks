{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start E2E Environment",
      "detail": "v2: production frontend build on :4173 (ngrok tunnels it as APP_DOMAIN) + Django on :8000 + Celery worker/beat. ngrok supplies the public HTTPS origin the Xero OAuth callback and webhook need. v1 usually holds :8000 \u2014 stop it first.",
      "dependsOn": [
        "Frontend Preview (build)",
        "Django (uvicorn)",
        "Ngrok Tunnels",
        "Celery Worker",
        "Celery Beat"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Frontend Preview (build)",
      "type": "process",
      "command": "${env:HOME}/.nvm/nvm-exec",
      "args": [
        "npm",
        "run",
        "preview:e2e"
      ],
      "hide": true,
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite-preview",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local:"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Django (uvicorn)",
      "type": "process",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "config.asgi:application",
        "--port",
        "8000"
      ],
      "options": {
        "env": {
          "PYTHONPATH": "${workspaceFolder}"
        }
      },
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "django",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Uvicorn running on"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Ngrok Tunnels",
      "type": "process",
      "command": "${workspaceFolder}/scripts/ops/start_ngrok_when_ready.sh",
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "ngrok",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "started tunnel"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Celery Worker",
      "type": "shell",
      "command": "uv run celery -A config worker --concurrency=4 --loglevel=info",
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "celery-worker",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "ready."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Celery Beat",
      "type": "shell",
      "command": "uv run celery -A config beat --loglevel=info",
      "hide": true,
      "isBackground": true,
      "problemMatcher": {
        "owner": "celery-beat",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "beat: Starting\\.\\.\\."
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
