__pycache__/
*.py[cod]
.venv/
.env
# ngrok config holds your authtoken; commit ngrok.yml.example only.
ngrok.yml
.mypy_cache/
.pytest_cache/
.ruff_cache/
# User-uploaded media is untracked, but the committed app assets (referenced
# by the golden-PDF fixtures as ``app_images/...`` under MEDIA_ROOT) are not.
mediafiles/*
!mediafiles/app_images/
!mediafiles/app_images/**
logs/
node_modules/
frontend/dist/
# Playwright E2E credentials (E2E_TEST_USERNAME/PASSWORD); commit .env.test.example only.
frontend/.env.test
frontend/test-results/
# run_e2e.sh's Playwright invocation also writes artifacts relative to the
# repo root in some invocations, not just frontend/test-results/.
/test-results/
frontend/playwright-report/
frontend/coverage/
# Pulled prod dumps (pull_prod_backup.sh) and Playwright's E2E DB backups
# (pg_dump taken by global setup, deleted by teardown) both land in restore/;
# only the placeholder that keeps the directory tracked survives here.
restore/*
!restore/.gitkeep
# Prod backups fetched by scripts/backup_db.sh and friends.
backups/
.coverage
htmlcov/
.test-dropbox-workflow/
.test-phone-recordings/
.qwen/
# Celery beat's scheduler state (shelve db written at runtime).
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
