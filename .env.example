# Required — settings.py fails fast if any of these are missing.
JWT_SIGNING_KEY=
SECRET_KEY=
DEBUG=true
APP_DOMAIN=localhost
DB_NAME=docketworks_v2
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
REDIS_URL=redis://localhost:6379/1
FRONT_END_URL=http://localhost:5173
DROPBOX_WORKFLOW_FOLDER=
PHONE_RECORDING_STORAGE_ROOT=
MEDIA_ROOT=mediafiles
XERO_READONLY=false

# Optional — only the scrub-pipeline commands read it (`backport_data_backup`,
# the scrubbed-dump producer run on a production host, and
# `export_dev_demo_dump`). Must end in _scrub; leave empty everywhere else and
# no scrub database alias is defined.
SCRUB_DB_NAME=

# Optional — only config/settings_test.py reads these (never the app). Server
# instances get a per-tenant pytest role provisioned by
# scripts/server/instance.sh; dev checkouts leave both unset and pytest
# connects as DB_USER instead.
TEST_DB_USER=
TEST_DB_PASSWORD=

# Optional — only the scripts/gdocs/ authoring toolchain reads these (never the
# app). Path to the Google service-account key JSON, and an override for the
# Workspace user it impersonates (defaults to CompanyDefaults.company_email).
GCP_CREDENTIALS=
GCP_DELEGATED_SUBJECT=

# Optional — company address geocoding (apps/company/services/geocoding_service).
# Unset means geocoding refuses loudly (GeocodingNotConfiguredError); nothing
# else reads it.
GOOGLE_MAPS_API_KEY=
