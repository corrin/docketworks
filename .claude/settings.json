{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-slow-checks.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for slow verification commands"
          }
        ]
      }
    ]
  }
}
